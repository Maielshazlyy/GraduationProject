# Copy this file to .env and fill in the values
# docker-compose up will pick these up automatically

# SQL Server password (min 8 chars, 1 uppercase, 1 digit, 1 special char)
SA_PASSWORD=Admin@12345!

# JWT secret key (use a long random string in production)
JWT_KEY=SuperSecretJwtKey_ChangeThisToSomethingLong_AtLeast32Chars!

# JWT issuer/audience (set to your public URL when deployed)
JWT_ISSUER=http://localhost:10000
JWT_AUDIENCE=http://localhost:10000

# Google OAuth
GOOGLE_CLIENT_ID=1056832144934-iiifdepah1edobbfcbnhgkulo2mek7gt.apps.googleusercontent.com

# AI FastAPI server URL
AI_BASE_URL=https://anyway-remix-puzzling.ngrok-free.dev
