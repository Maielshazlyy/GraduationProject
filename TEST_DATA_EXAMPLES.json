            "askOrderStatus": "What is my order status",
            "complaint": "I'm not satisfied with my order",
            "requestHuman": "I want to talk to a human agent",
            "askProducts": "Show me the menu",
            "cancelOrder": "I want to cancel my order"
        }
    },
    "jwtTokenInfo": {
        "structure": {
            "header": {
                "alg": "HS256",
                "typ": "JWT"
            },
            "payload": {
                "sub": "user-id",
                "email": "user@example.com",
                "name": "User Name",
                "role": "Owner",
                "BusinessId": "business-id",
                "exp": 1234567890,
                "iss": "https://localhost:44361",
                "aud": "https://localhost:44361"
            }
        },
        "expiration": "3 days",
        "claims": [
            "sub (NameIdentifier): User ID",
            "email: User Email",
            "name: Full Name",
            "role: Role (Admin/Owner/Agent/User)",
            "BusinessId: Business ID (if exists)"
        ]
    },
    "commonErrors": {
        "400": {
            "message": "Bad Request",
            "commonCauses": [
                "Missing required fields",
                "Invalid BusinessId",
                "Invalid format"
            ]
        },
        "401": {
            "message": "Unauthorized",
            "commonCauses": [
                "Missing or invalid JWT Token",
                "Token expired",
                "Wrong role permissions"
            ],
            "solution": "Login again to get new token"
        },
        "404": {
            "message": "Not Found",
            "commonCauses": [
                "BusinessId doesn't exist",
                "InteractionId doesn't exist",
                "MessageId doesn't exist"
            ]
        },
        "500": {
            "message": "Internal Server Error",
            "commonCauses": [
                "Database connection issue",
                "Server error",
                "Missing configuration"
            ],
            "solution": "Check server logs"
        }
    },
    "testingWorkflow": {
        "step1": {
            "action": "Start the project",
            "command": "F5 in Visual Studio (IIS Express) or dotnet run",
            "expected": "API running on https://localhost:44361 (IIS Express) or https://localhost:7119 (dotnet run)"
        },
        "step2": {
            "action": "Open Swagger",
            "url": "https://localhost:44361/swagger (IIS Express) or https://localhost:7119/swagger (dotnet run)",
            "expected": "Swagger UI opens successfully"
        },
        "step3": {
            "action": "Import Postman Collection & Environment",
            "files": [
                "AI_Endpoints_Postman_Collection.json",
                "Postman_Environment.json"
            ],
            "expected": "Collection and Environment imported"
        },
        "step4": {
            "action": "Get JWT Token",
            "endpoint": "Authentication → Login - Owner",
            "expected": "Token saved automatically to jwtToken variable"
        },
        "step5": {
            "action": "Set BusinessId",
            "source": "From login response or database",
            "expected": "businessId variable set in environment"
        },
        "step6": {
            "action": "Test Chat Endpoint",
            "endpoint": "Customer Chat → Send Chat Message (Arabic)",
            "expected": "Response with interactionId and replyText"
        },
        "step7": {
            "action": "Test Sentiment Analysis",
            "endpoint": "Sentiment Analysis → Get Sentiment by Message ID",
            "expected": "Sentiment analysis result"
        }
    }
