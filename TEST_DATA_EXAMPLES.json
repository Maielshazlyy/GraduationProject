    "sampleRequests": {
        "register": {
            "endpoint": "POST /api/Auth/register",
            "body": {
                "fullName": "Test Owner",
                "email": "owner@test.com",
                "password": "Owner123!",
                "businessId": null
            },
            "response": {
                "userId": "user-guid",
                "email": "owner@test.com",
                "fullName": "Test Owner",
                "role": "User",
                "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                "expiration": "2024-01-18T10:30:00Z",
                "businessId": null
            }
        },
        "login": {
            "endpoint": "POST /api/Auth/login",
            "body": {
                "email": "owner@test.com",
                "password": "Owner123!"
            },
            "response": {
                "userId": "user-guid",
                "email": "owner@test.com",
                "fullName": "Test Owner",
                "role": "Owner",
                "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                "expiration": "2024-01-18T10:30:00Z",
                "businessId": "business-guid"
            }
        },
        "chatMessageArabic": {
            "endpoint": "POST /api/CustomerChat/message",
            "body": {
                "businessId": "your-business-id",
                "customerId": null,
                "interactionId": null,
                "channel": "WebChat",
                "message": "عايز أطلب برجر"
            },
            "response": {
                "interactionId": "interaction-guid",
                "replyText": "تمام، سجلت لك طلب جديد...",
                "orderId": "order-guid",
                "ticketId": null,
                "cart": {
                    "totalPrice": 50.00,
                    "items": [
                        {
                            "menuItemId": "item-guid",
                            "name": "برجر",
                            "quantity": 1,
                            "unitPrice": 50.00
                        }
                    ]
                },
                "recommendations": [
                    {
                        "menuItemId": "item-guid-2",
                        "name": "بطاطس",
                        "price": 10.00,
                        "reason": "Popular side with burgers"
                    }
                ],
                "isInterrupted": false
            }
        },
        "chatMessageEnglish": {
            "endpoint": "POST /api/CustomerChat/message",
            "body": {
                "businessId": "your-business-id",
                "customerId": null,
                "interactionId": null,
                "channel": "WebChat",
                "message": "I want to order a burger"
            }
        },
        "voiceSessionInitialize": {
            "endpoint": "POST /api/CustomerVoice/session/initialize",
            "body": {
                "businessId": "your-business-id",
                "customerId": null,
                "callSessionId": "call-session-123"
            },
            "response": {
                "interactionId": "interaction-guid",
                "channel": "Voice",
                "status": "Open",
                "callSessionId": "call-session-123",
                "startedAt": "2024-01-15T10:30:00Z"
            }
        },
        "getSentiment": {
            "endpoint": "GET /api/Sentiment/message/{messageId}",
            "headers": {
                "Authorization": "Bearer {jwtToken}"
            },
            "response": [
                {
                    "sentimentId": "sentiment-guid",
                    "messageId": "message-guid",
                    "sourceText": "عايز أطلب برجر",
                    "label": "Positive",
                    "score": 0.8,
                    "analyzedAt": "2024-01-15T10:30:00Z"
                }
            ]
        }
    },
