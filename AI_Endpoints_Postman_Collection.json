    "item": [
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Register New User",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.environment.set(\"jwtToken\", jsonData.token);",
                                    "    pm.environment.set(\"userId\", jsonData.userId);",
                                    "    pm.environment.set(\"businessId\", jsonData.businessId || \"\");",
                                    "    console.log(\"Token saved to environment\");",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"fullName\": \"Test User\",\n    \"email\": \"{{testOwnerEmail}}\",\n    \"password\": \"{{testOwnerPassword}}\",\n    \"businessId\": null\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/Auth/register",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "Auth",
                                "register"
                            ]
                        },
                        "description": "Register a new user and automatically save token to environment"
                    },
                    "response": []
                },
